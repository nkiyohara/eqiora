model axial_bar {
  domain bar = box(0, 2);
  domain fixed_end = boundary(bar, axis = 0, side = lower);
  domain loaded_end = boundary(bar, axis = 0, side = upper);
  representation body_space = continuum;

  field displacement on bar as body_space: m = 0;
  parameter youngs_modulus: kg / m / s ^ 2 = 200e9;
  parameter area: m ^ 2 = 0.01;
  parameter applied_force: kg * m / s ^ 2 = 10000;

  relation equilibrium continuous on bar {
    -div(youngs_modulus * area * grad(displacement)) = 0;
  }
  relation clamp continuous on fixed_end {
    trace(displacement) = 0;
  }
  relation end_load continuous on loaded_end {
    normal(youngs_modulus * area * grad(displacement)) - applied_force = 0;
  }
}
