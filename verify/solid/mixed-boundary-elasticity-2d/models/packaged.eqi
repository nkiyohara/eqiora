model Main {
  domain body = box(0, 1, 0, 1);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);
  representation space = continuum;

  field displacement on body as space: m shape spatial_vector;
  field load_potential on body as space: kg / (m * s ^ 2) = 0;
  parameter mu: kg / (m * s ^ 2) = 3;
  parameter lambda: kg / (m * s ^ 2) = 0;
  parameter length_scale: m = 1;

  relation load continuous on body {
    load_potential - 2 * mu * coordinate(0) / length_scale = 0;
  }
  instance balance_law: solid.IsotropicBalanceWithPotential2d(
    support body = body,
    field displacement = displacement,
    field load_potential = load_potential,
    mu = mu,
    lambda = lambda
  );
  instance boundary_law: solid.IsotropicMechanicalInterface2d(
    support body = body,
    support exterior = boundaries(x_lower, x_upper, y_lower, y_upper),
    field displacement = displacement,
    mu = mu,
    lambda = lambda
  );
  instance fixed: solid.FixedDisplacement2d(
    support body = body,
    support face = x_lower
  );
  instance x_upper_free: solid.ZeroTraction2d(
    support body = body,
    support face = x_upper
  );
  instance y_lower_free: solid.ZeroTraction2d(
    support body = body,
    support face = y_lower
  );
  instance y_upper_free: solid.ZeroTraction2d(
    support body = body,
    support face = y_upper
  );

  connect conserving boundary_law.mechanical[boundary = x_lower], fixed.mechanical;
  connect conserving boundary_law.mechanical[boundary = x_upper], x_upper_free.mechanical;
  connect conserving boundary_law.mechanical[boundary = y_lower], y_lower_free.mechanical;
  connect conserving boundary_law.mechanical[boundary = y_upper], y_upper_free.mechanical;
}
