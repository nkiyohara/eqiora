public component BoundaryTerminal {
  public support body: volume(ambient_dimension = 2);
  public support face: boundary(parent = body);
  public port mechanical:
    conserving solid.QuasistaticMechanicalBoundary over face;

  relation free_traction continuous on face {
    flux(mechanical) = 0;
  }
}

model Main {
  domain body = box(0, 1, 0, 1);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);
  representation space = continuum;
  field displacement on body as space: m shape spatial_vector;
  parameter lambda: kg / (m * s ^ 2) = 2;
  parameter mu: kg / (m * s ^ 2) = 3;

  instance solid_boundary: solid.IsotropicMechanicalInterface2d(
    support body = body,
    support exterior = boundaries(x_upper, y_lower, x_lower, y_upper),
    field displacement = displacement,
    mu = mu,
    lambda = lambda
  );
  instance x_lower_terminal: BoundaryTerminal(
    support body = body,
    support face = x_lower
  );
  instance x_upper_terminal: BoundaryTerminal(
    support body = body,
    support face = x_upper
  );
  instance y_lower_terminal: BoundaryTerminal(
    support body = body,
    support face = y_lower
  );
  instance y_upper_terminal: BoundaryTerminal(
    support body = body,
    support face = y_upper
  );

  connect conserving solid_boundary.mechanical[boundary = x_lower],
    x_lower_terminal.mechanical;
  connect conserving solid_boundary.mechanical[boundary = x_upper],
    x_upper_terminal.mechanical;
  connect conserving solid_boundary.mechanical[boundary = y_lower],
    y_lower_terminal.mechanical;
  connect conserving solid_boundary.mechanical[boundary = y_upper],
    y_upper_terminal.mechanical;
}
