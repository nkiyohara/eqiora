public connector SolidBoundary {
  trace displacement: m;
  flux traction: kg / (m * s ^ 2);
  shape spatial_vector;
  frame spatial;
  pairing euclidean_boundary_duality;
  orientation parent_outward;
}

public connector TerminalBoundary {
  trace displacement: m;
  flux traction: kg / (m * s ^ 2);
  shape spatial_vector;
  frame spatial;
  pairing euclidean_boundary_duality;
  orientation parent_outward;
}

public component ExteriorLaw(
  support body: volume(ambient_dimension = 2),
  support exterior: complete_exterior(parent = body),
  port mechanical[boundary in exterior]: SolidBoundary over boundary
) {
}

public component BoundaryTerminal(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: TerminalBoundary over face
) {
}

model Main() {
  domain body = box(0, 1, 0, 1);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);

  instance solid: ExteriorLaw(
    body = body,
    exterior = boundaries(x_lower, x_upper, y_lower, y_upper)
  );
  instance terminal: BoundaryTerminal(
    body = body,
    face = x_lower
  );
  connect solid.mechanical[boundary = x_lower], terminal.mechanical;
}
