public connector Pin {
  across voltage: kg * m ^ 2 / (s ^ 3 * A);
  through current: A;
}

public component IdealVoltageSource(
  parameter voltage: kg * m ^ 2 / (s ^ 3 * A),
  port positive: Pin,
  port negative: Pin
) {
  relation law {
    positive.voltage - negative.voltage - voltage = 0;
    positive.current + negative.current = 0;
  }
}

component Resistor(
  parameter resistance: kg * m ^ 2 / (s ^ 3 * A ^ 2),
  port positive: Pin,
  port negative: Pin
) {
  relation law {
    positive.voltage - negative.voltage - resistance * positive.current = 0;
    positive.current + negative.current = 0;
  }
}

public component ResistiveBranch(
  parameter resistance: kg * m ^ 2 / (s ^ 3 * A ^ 2),
  port positive: Pin,
  port negative: Pin
) {
  instance element: Resistor(resistance = resistance);

  connect positive, element.positive;
  connect negative, element.negative;
}

public component Ground(
  port terminal: Pin
) {
  relation law {
    terminal.voltage = 0;
  }
}
