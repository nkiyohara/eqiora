connector Pin {
  across potential: 1;
  through flow: 1;
}

component OpenPair(
  port a: Pin,
  port b: Pin
) {
}

model Main() {
  instance closed: OpenPair();
  instance open: OpenPair();
  relation closed_owner {
    closed.a.potential + closed.b.potential = 0;
  }
  relation open_owner {
    open.a.potential + open.b.potential = 0;
  }
  connect closed.a, closed.b;
}
