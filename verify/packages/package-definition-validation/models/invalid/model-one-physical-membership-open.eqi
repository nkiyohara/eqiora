connector Pin {
  across potential: 1;
  through flow: 1;
}

component OpenTriple(
  port a: Pin,
  port b: Pin,
  port c: Pin
) {
}

model Main() {
  instance triple: OpenTriple();
  relation owner {
    triple.a.potential + triple.b.potential + triple.c.potential = 0;
  }
  connect triple.a, triple.b;
}
