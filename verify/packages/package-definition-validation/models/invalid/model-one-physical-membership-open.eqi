connector Pin = scalar_physical(across = 1, through = 1);

component OpenTriple(
  port a: conserving on Pin,
  port b: conserving on Pin,
  port c: conserving on Pin
) {
}

model Main() {
  instance triple: OpenTriple;
  relation owner {
    across(triple.a) + across(triple.b) + across(triple.c) = 0;
  }
  connect conserving triple.a, triple.b;
}
