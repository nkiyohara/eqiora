connector Pin {
  across potential: 1;
  through flow: 1;
}

component Leaf(
  port left: Pin,
  port right: Pin
) {
}

component ClosedPair() {
  instance leaf: Leaf();
  relation law {
    leaf.left.potential + leaf.right.potential = 0;
  }
  connect leaf.left, leaf.right;
}

model Main() {
  instance pair: ClosedPair();
}
