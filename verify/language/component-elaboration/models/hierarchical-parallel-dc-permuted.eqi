connector Pin {
  across voltage: kg * m ^ 2 / (s ^ 3 * A);
  through current: A;
}

component Ground(
  port terminal: Pin
) {
  relation law {
    terminal.voltage = 0;
  }
}

component Resistor(
  port negative: Pin,
  port positive: Pin,
  parameter resistance: kg * m ^ 2 / (s ^ 3 * A ^ 2)
) {
  relation law {
    positive.voltage - negative.voltage - resistance * positive.current = 0;
    positive.current + negative.current = 0;
  }
}

component VoltageSource(
  port negative: Pin,
  parameter voltage: kg * m ^ 2 / (s ^ 3 * A),
  port positive: Pin
) {
  relation law {
    positive.voltage - negative.voltage - voltage = 0;
    positive.current + negative.current = 0;
  }
}

component ParallelDc(
  parameter resistance_four: kg * m ^ 2 / (s ^ 3 * A ^ 2),
  parameter supply_voltage: kg * m ^ 2 / (s ^ 3 * A),
  parameter resistance_two: kg * m ^ 2 / (s ^ 3 * A ^ 2)
) {
  instance ground: Ground();
  instance resistor_four: Resistor(resistance = resistance_four);
  instance source: VoltageSource(voltage = supply_voltage);
  instance resistor_two: Resistor(resistance = resistance_two);

  connect ground.terminal, resistor_four.negative, resistor_two.negative, source.negative;
  connect resistor_four.positive, resistor_two.positive, source.positive;
}

model component_elaboration() {
  parameter resistance_four: kg * m ^ 2 / (s ^ 3 * A ^ 2) = 4;
  parameter supply_voltage: kg * m ^ 2 / (s ^ 3 * A) = 12;
  parameter resistance_two: kg * m ^ 2 / (s ^ 3 * A ^ 2) = 2;

  instance circuit: ParallelDc(
    resistance_four = resistance_four,
    resistance_two = resistance_two,
    supply_voltage = supply_voltage
  );
}
