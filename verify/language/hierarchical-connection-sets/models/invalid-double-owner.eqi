connector Pin = scalar_physical(across = 1, through = 1);

component Broken(
  port p: conserving on Pin,
  port q: conserving on Pin
) {
  relation first_owner { across(p) = 0; }
  relation second_owner { through(p) = 0; }
  relation q_owner { across(q) = 0; }
  connect conserving p, q;
}

model Network() { instance broken: Broken; }
