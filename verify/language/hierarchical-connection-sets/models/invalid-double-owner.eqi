connector Pin {
  across potential: 1;
  through flow: 1;
}

component Broken(
  port p: Pin,
  port q: Pin
) {
  relation first_owner { p.potential = 0; }
  relation second_owner { p.flow = 0; }
  relation q_owner { q.potential = 0; }
  connect p, q;
}

model Network() { instance broken: Broken(); }
