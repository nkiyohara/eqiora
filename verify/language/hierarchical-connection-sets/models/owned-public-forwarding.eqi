connector Pin {
  across potential: 1;
  through flow: 1;
}

component Leaf(
  port p: Pin
) {
  relation owner { p.potential = 0; }
}

component OwnedWrapper(
  port p: Pin
) {
  instance leaf: Leaf();
  relation public_owner { p.potential = 0; }
  connect p, leaf.p;
}

model Network() {
  instance left: OwnedWrapper();
  instance right: Leaf();
  connect left.p, right.p;
}
