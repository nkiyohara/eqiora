connector Pin = scalar_physical(across = 1, through = 1);

component Leaf(
  port p: conserving on Pin
) {
  relation owner { across(p) = 0; }
}

component Inner(
  port p: conserving on Pin
) {
  instance leaf: Leaf();
  connect conserving p, leaf.p;
}

component Outer(
  port p: conserving on Pin
) {
  instance inner: Inner();
  connect conserving p, inner.p;
}

model Network() {
  instance left: Outer();
  instance right: Leaf();
  connect conserving left.p, right.p;
}
