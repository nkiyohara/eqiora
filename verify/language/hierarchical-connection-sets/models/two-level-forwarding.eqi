connector Pin {
  across potential: 1;
  through flow: 1;
}

component Leaf(
  port p: Pin
) {
  relation owner { p.potential = 0; }
}

component Inner(
  port p: Pin
) {
  instance leaf: Leaf();
  connect p, leaf.p;
}

component Outer(
  port p: Pin
) {
  instance inner: Inner();
  connect p, inner.p;
}

model Network() {
  instance left: Outer();
  instance right: Leaf();
  connect left.p, right.p;
}
