connector Pin {
  across potential: 1;
  through flow: 1;
}

component Leaf(
  port p: Pin
) {
  relation owner { p.potential = 0; }
}

component Pair(
  port p: Pin,
  port q: Pin
) {
  instance left: Leaf();
  instance right: Leaf();
  connect p, left.p;
  connect q, right.p;
}

model Network() {
  instance pair: Pair();
  instance outside: Leaf();
  connect pair.p, pair.q, outside.p;
}
