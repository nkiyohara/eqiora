connector Pin {
  across potential: 1;
  through flow: 1;
}

component Terminal(
  port p: Pin
) {
  relation owner { p.potential = 0; }
}

model Network() {
  instance a: Terminal();
  instance b: Terminal();
  instance c: Terminal();
  instance d: Terminal();
  connect a.p, b.p;
  connect c.p, d.p;
}
