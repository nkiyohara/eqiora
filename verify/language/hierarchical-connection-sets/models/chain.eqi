connector Pin = scalar_physical(across = 1, through = 1);

component Terminal(
  port p: conserving on Pin
) {
  relation owner { across(p) = 0; }
}

model Network() {
  instance a: Terminal;
  instance b: Terminal;
  instance c: Terminal;
  connect conserving a.p, b.p;
  connect conserving b.p, c.p;
}
