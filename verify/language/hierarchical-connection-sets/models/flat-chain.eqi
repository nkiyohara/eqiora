model Network() {
  domain physical = scalar_physical(across potential: 1, through flow: 1);
  port a: physical;
  port b: physical;
  port c: physical;
  relation owner {
    a.potential - b.potential = 0;
    b.potential - c.potential = 0;
    a.flow + b.flow + c.flow = 0;
  }
  connect a, b;
  connect b, c;
}
