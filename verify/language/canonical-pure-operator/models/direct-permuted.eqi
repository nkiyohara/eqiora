public operator identity(input x: scalar): scalar = component(x);
public operator dyadic(input a: spatial[1], input b: spatial[1]): spatial[2]
  = component(a, 0) * component(b, 1);

model Main() {
  domain body = box(0, 1, 0, 1);
  variable right: vector<1, 2> on body;
  variable left: vector<1, 2> on body;
  relation balance on body {
    div(div(dyadic(a = left, b = right))) = 0;
  }
}
