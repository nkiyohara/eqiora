public connector VelocityTractionBoundary = field_physical(
  trace = velocity: m / s,
  flux = traction: kg / (m * s ^ 2),
  shape = spatial_vector,
  frame = spatial,
  pairing = euclidean_boundary_duality
);

public component ElastodynamicMechanicalInterface3d {
  public support body: volume(ambient_dimension = 3);
  public support exterior: complete_exterior(parent = body);
  public field slot displacement on body as continuum: m shape spatial_vector;
  public field slot velocity on body as continuum: m / s shape spatial_vector;
  public parameter mu: kg / (m * s ^ 2);
  public parameter lambda: kg / (m * s ^ 2);

  public port mechanical[boundary in exterior]:
    conserving VelocityTractionBoundary over boundary;

  relation boundary_interface[boundary in exterior] continuous on boundary {
    trace(velocity)
      - trace(mechanical[boundary = boundary]) = 0;
    normal(
      2 * mu * symmetric_part(grad(displacement))
      + lambda * isotropic_lift(div(displacement))
    ) - flux(mechanical[boundary = boundary]) = 0;
  }
}

public component ZeroVelocity3d {
  public support body: volume(ambient_dimension = 3);
  public support face: boundary(parent = body);
  public port mechanical:
    conserving VelocityTractionBoundary over face;

  relation prescribed_velocity continuous on face {
    trace(mechanical) = 0;
  }
}

public component ZeroTraction3d {
  public support body: volume(ambient_dimension = 3);
  public support face: boundary(parent = body);
  public port mechanical:
    conserving VelocityTractionBoundary over face;

  relation prescribed_traction continuous on face {
    flux(mechanical) = 0;
  }
}

public component OpenVelocityTerminal3d {
  public support body: volume(ambient_dimension = 3);
  public support face: boundary(parent = body);
  public port mechanical:
    conserving VelocityTractionBoundary over face;

  relation transparent_carrier continuous on face {
    trace(mechanical) - trace(mechanical) = 0;
    flux(mechanical) - flux(mechanical) = 0;
  }
}

model Main {
  domain body = box(0, 1, 0, 1, 0, 1);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);
  domain z_lower = boundary(body, axis = 2, side = lower);
  domain z_upper = boundary(body, axis = 2, side = upper);
  representation space = continuum;

  field displacement on body as space: m shape spatial_vector;
  field velocity on body as space: m / s shape spatial_vector;
  field load_potential on body as space: kg / (m * s ^ 2) = 0;
  parameter density: kg / m ^ 3 = 2;
  parameter mu: kg / (m * s ^ 2) = 3;
  parameter lambda: kg / (m * s ^ 2) = 0;
  parameter zero_pressure: kg / (m * s ^ 2) = 0;

  relation load_definition continuous on body {
    load_potential - zero_pressure = 0;
  }
  relation kinematics continuous on body {
    derivative(displacement) - velocity = 0;
  }
  relation momentum continuous on body {
    density * derivative(velocity)
      - div(
        2 * mu * symmetric_part(grad(displacement))
        + lambda * isotropic_lift(div(displacement))
      )
      - grad(load_potential) = 0;
  }

  instance boundary: ElastodynamicMechanicalInterface3d(
    support body = body,
    support exterior = boundaries(
      x_lower, x_upper, y_lower, y_upper, z_lower, z_upper
    ),
    field displacement = displacement,
    field velocity = velocity,
    mu = mu,
    lambda = lambda
  );

  instance x_lower_zero: ZeroVelocity3d(
    support body = body, support face = x_lower
  );
  instance x_upper_driven: OpenVelocityTerminal3d(
    support body = body, support face = x_upper
  );
  instance y_lower_zero: ZeroTraction3d(
    support body = body, support face = y_lower
  );
  instance y_upper_zero: ZeroTraction3d(
    support body = body, support face = y_upper
  );
  instance z_lower_zero: ZeroTraction3d(
    support body = body, support face = z_lower
  );
  instance z_upper_zero: ZeroTraction3d(
    support body = body, support face = z_upper
  );

  connect conserving
    boundary.mechanical[boundary = x_lower], x_lower_zero.mechanical;
  connect conserving
    boundary.mechanical[boundary = x_upper], x_upper_driven.mechanical;
  connect conserving
    boundary.mechanical[boundary = y_lower], y_lower_zero.mechanical;
  connect conserving
    boundary.mechanical[boundary = y_upper], y_upper_zero.mechanical;
  connect conserving
    boundary.mechanical[boundary = z_lower], z_lower_zero.mechanical;
  connect conserving
    boundary.mechanical[boundary = z_upper], z_upper_zero.mechanical;
}
