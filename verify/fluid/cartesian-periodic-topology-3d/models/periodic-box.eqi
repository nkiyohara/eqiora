public connector PeriodicBoundary = field_physical(
  trace = state: 1,
  flux = normal_flux: 1,
  shape = [],
  frame = invariant,
  pairing = euclidean_boundary_duality
);

public component PeriodicSide3d {
  public support body: volume(ambient_dimension = 3);
  public support face: boundary(parent = body);
  public port periodic: conserving PeriodicBoundary over face;

  relation carrier continuous on face {
    trace(periodic) - trace(periodic) = 0;
    flux(periodic) - flux(periodic) = 0;
  }
}

model PeriodicBox3d {
  domain body = box(-2, 3, 1, 8, -1, 10);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);
  domain z_lower = boundary(body, axis = 2, side = lower);
  domain z_upper = boundary(body, axis = 2, side = upper);

  instance x_lower_side: PeriodicSide3d(
    support body = body,
    support face = x_lower
  );
  instance x_upper_side: PeriodicSide3d(
    support body = body,
    support face = x_upper
  );
  instance y_lower_side: PeriodicSide3d(
    support body = body,
    support face = y_lower
  );
  instance y_upper_side: PeriodicSide3d(
    support body = body,
    support face = y_upper
  );
  instance z_lower_side: PeriodicSide3d(
    support body = body,
    support face = z_lower
  );
  instance z_upper_side: PeriodicSide3d(
    support body = body,
    support face = z_upper
  );

  connect periodic x_lower_side.periodic, x_upper_side.periodic;
  connect periodic y_lower_side.periodic, y_upper_side.periodic;
  connect periodic z_lower_side.periodic, z_upper_side.periodic;
}
