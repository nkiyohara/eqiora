public connector PeriodicBoundary {
  trace state: 1;
  flux normal_flux: 1;
  shape [];
  frame invariant;
  pairing euclidean_boundary_duality;
  orientation parent_outward;
}

public component PeriodicSide3d(
  support body: volume(ambient_dimension = 3),
  support face: boundary(parent = body),
  port periodic: PeriodicBoundary over face
) {
  relation carrier on face {
    periodic.state - periodic.state = 0;
    periodic.normal_flux - periodic.normal_flux = 0;
  }
}

model PeriodicBox3d() {
  domain z_upper = boundary(body, axis = 2, side = upper);
  domain y_lower = boundary(body, axis = 1, side = lower);
  domain body = box(-2, 3, 1, 8, -1, 10);
  domain x_upper = boundary(body, axis = 0, side = upper);
  domain z_lower = boundary(body, axis = 2, side = lower);
  domain x_lower = boundary(body, axis = 0, side = lower);
  domain y_upper = boundary(body, axis = 1, side = upper);

  instance z_upper_side: PeriodicSide3d(
    body = body,
    face = z_upper
  );
  instance x_lower_side: PeriodicSide3d(
    body = body,
    face = x_lower
  );
  instance y_upper_side: PeriodicSide3d(
    body = body,
    face = y_upper
  );
  instance z_lower_side: PeriodicSide3d(
    body = body,
    face = z_lower
  );
  instance y_lower_side: PeriodicSide3d(
    body = body,
    face = y_lower
  );
  instance x_upper_side: PeriodicSide3d(
    body = body,
    face = x_upper
  );

  connect periodic z_upper_side.periodic, z_lower_side.periodic;
  connect periodic x_upper_side.periodic, x_lower_side.periodic;
  connect periodic y_upper_side.periodic, y_lower_side.periodic;
}
