{
  "schema": "eqiora.studio.cad-authored-python-export-hostiles/v1",
  "protocol": "eqiora.studio.cad-authored-python-export/v1",
  "requestFields": ["protocol", "canonicalGraphHex", "graphDigest"],
  "renderResponseFields": [
    "protocol",
    "graphDigest",
    "suggestedFileName",
    "sourceUtf8"
  ],
  "saveResponseFields": ["protocol", "graphDigest", "status"],
  "suggestedFileName": "eqiora_authored_cad.py",
  "bridgeRequestMutants": [
    {
      "id": "unknown-protocol",
      "base": "v1",
      "mutation": "replace-protocol",
      "value": "eqiora.studio.cad-authored-python-export/v2",
      "expect": "reject-request"
    },
    {
      "id": "unknown-field",
      "base": "v1",
      "mutation": "add-json-field",
      "field": "unknown",
      "value": true,
      "expect": "reject-request"
    },
    {
      "id": "client-path",
      "base": "v1",
      "mutation": "add-json-field",
      "field": "path",
      "value": "/tmp/forbidden.py",
      "expect": "reject-request"
    },
    {
      "id": "client-source",
      "base": "v1",
      "mutation": "add-json-field",
      "field": "sourceUtf8",
      "value": "import os\n",
      "expect": "reject-request"
    },
    {
      "id": "odd-graph-hex",
      "base": "v1",
      "mutation": "replace-canonical-graph-hex",
      "value": "a",
      "expect": "reject-request"
    },
    {
      "id": "uppercase-graph-hex",
      "base": "v1",
      "mutation": "replace-canonical-graph-hex",
      "value": "AA",
      "expect": "reject-request"
    },
    {
      "id": "oversized-graph-hex",
      "base": "v1",
      "mutation": "replace-canonical-graph-hex-repeat",
      "value": "ab",
      "repeat": 2049,
      "expect": "reject-request"
    },
    {
      "id": "unknown-canonical-wire",
      "base": "v1",
      "mutation": "replace-decoded-canonical-wire",
      "value": "{\"schema\":\"unknown\"}",
      "expect": "reject-request"
    },
    {
      "id": "duplicate-canonical-field",
      "base": "v1",
      "mutation": "replace-decoded-canonical-substring",
      "needle": "\"length_unit\":",
      "value": "\"length_unit\":\"metre\",\"length_unit\":",
      "expect": "reject-request"
    },
    {
      "id": "oversized-canonical-wire",
      "base": "v1",
      "mutation": "replace-decoded-canonical-wire-repeat",
      "value": "x",
      "repeat": 4097,
      "expect": "reject-request"
    },
    {
      "id": "stale-digest",
      "base": "v1",
      "mutation": "replace-digest-first-nibble",
      "value": "0",
      "expect": "reject-request"
    },
    {
      "id": "cross-version-substitution",
      "base": "v1",
      "mutation": "replace-canonical-graph-with-v2-keep-v1-digest",
      "expect": "reject-request"
    },
    {
      "id": "tolerance-only-substitution",
      "base": "v1",
      "mutation": "construct-v1-with-modeling-tolerance-keep-v1-digest",
      "value": 2e-9,
      "expect": "reject-request"
    }
  ],
  "renderResponseMutants": [
    {
      "id": "wrong-protocol",
      "base": "v1",
      "mutation": "replace-protocol",
      "value": "eqiora.studio.cad-authored-python-export/v2",
      "expect": "reject-response"
    },
    {
      "id": "wrong-digest",
      "base": "v1",
      "mutation": "replace-digest-first-nibble",
      "value": "0",
      "expect": "reject-response"
    },
    {
      "id": "wrong-filename",
      "base": "v1",
      "mutation": "replace-suggested-filename",
      "value": "other.py",
      "expect": "reject-response"
    },
    {
      "id": "oversized-source",
      "base": "v1",
      "mutation": "replace-source-repeat",
      "value": "x",
      "repeat": 4097,
      "expect": "reject-response"
    },
    {
      "id": "nul-source",
      "base": "v1",
      "mutation": "append-source",
      "value": "\u0000",
      "expect": "reject-response"
    },
    {
      "id": "cr-source",
      "base": "v1",
      "mutation": "replace-source-substring",
      "needle": "\n",
      "value": "\r\n",
      "expect": "reject-response"
    },
    {
      "id": "missing-final-newline",
      "base": "v1",
      "mutation": "remove-final-source-newline",
      "expect": "reject-response"
    },
    {
      "id": "private-import",
      "base": "v1",
      "mutation": "replace-source-substring",
      "needle": "import eqiora\n",
      "value": "import eqiora._eqiora\n",
      "expect": "reject-response"
    },
    {
      "id": "canonical-blob",
      "base": "v1",
      "mutation": "append-source",
      "value": "authored_graph = eqiora.geometry.CadAuthoredGraph.decode_canonical(b\"x\")\n",
      "expect": "reject-response"
    },
    {
      "id": "widened-operation",
      "base": "v1",
      "mutation": "append-source",
      "value": "import os\n",
      "expect": "reject-response"
    }
  ],
  "sessionMutants": [
    {
      "id": "stale-render-after-rebuild",
      "start": "v1",
      "current": "v2",
      "response": "v1-render-success",
      "expect": "discard-stale"
    },
    {
      "id": "stale-save-after-rebuild",
      "start": "v1",
      "current": "v2",
      "response": "v1-save-success",
      "expect": "discard-stale"
    }
  ],
  "saveMutants": [
    {
      "id": "dialog-cancelled",
      "base": "v1",
      "dialog": "cancelled",
      "expectedWrites": 0,
      "expect": "cancelled"
    },
    {
      "id": "write-error",
      "base": "v1",
      "writer": "returns-error",
      "expect": "bounded-write-error-not-saved"
    }
  ]
}
