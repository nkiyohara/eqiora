model parallel_dc_network() {
  domain electrical = scalar_physical(across voltage: kg * m ^ 2 / (s ^ 3 * A), through current: A);

  parameter supply_voltage: kg * m ^ 2 / (s ^ 3 * A) = 12;
  parameter resistance_two: kg * m ^ 2 / (s ^ 3 * A ^ 2) = 2;
  parameter resistance_four: kg * m ^ 2 / (s ^ 3 * A ^ 2) = 4;

  port source_positive: electrical;
  port source_negative: electrical;
  port resistor_two_positive: electrical;
  port resistor_two_negative: electrical;
  port resistor_four_positive: electrical;
  port resistor_four_negative: electrical;
  port ground_terminal: electrical;

  relation voltage_source {
    source_positive.voltage - source_negative.voltage - supply_voltage = 0;
    source_positive.current + source_negative.current = 0;
  }
  relation two_ohm_resistor {
    resistor_two_positive.voltage
      - resistor_two_negative.voltage
      - resistance_two * resistor_two_positive.current = 0;
    resistor_two_positive.current + resistor_two_negative.current = 0;
  }
  relation four_ohm_resistor {
    resistor_four_positive.voltage
      - resistor_four_negative.voltage
      - resistance_four * resistor_four_positive.current = 0;
    resistor_four_positive.current + resistor_four_negative.current = 0;
  }
  relation explicit_ground {
    ground_terminal.voltage = 0;
  }

  connect source_positive, resistor_four_positive, resistor_two_positive;
  connect ground_terminal, resistor_two_negative, source_negative, resistor_four_negative;
}
