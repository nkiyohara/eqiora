import Eqiora.Electrical.Basic.basic as electrical;

public connector RotationalFlange {
  across speed: 1 / s;
  through torque: kg * m ^ 2 / s ^ 2;
}

public component ControlledVoltageSource(
  port positive: electrical.Pin,
  port negative: electrical.Pin,
  input command: kg * m ^ 2 / (s ^ 3 * A)
) {
  variable applied_voltage: kg * m ^ 2 / (s ^ 3 * A);

  relation law {
    applied_voltage - command = 0;
    positive.voltage - negative.voltage - applied_voltage = 0;
    positive.current + negative.current = 0;
  }
}

public component PermanentMagnetDcMotor(
  parameter resistance: kg * m ^ 2 / (s ^ 3 * A ^ 2),
  parameter inductance: kg * m ^ 2 / (s ^ 2 * A ^ 2),
  parameter motor_constant: kg * m ^ 2 / (s ^ 2 * A),
  port positive: electrical.Pin,
  port negative: electrical.Pin,
  port shaft: RotationalFlange
) {
  state current: A;
  variable speed: 1 / s;
  variable electromagnetic_torque: kg * m ^ 2 / s ^ 2;

  initial {
    current = 0;
  }

  relation coupled_law {
    positive.voltage - negative.voltage
      - resistance * current
      - inductance * derivative(current)
      - motor_constant * speed = 0;
    positive.current - current = 0;
    positive.current + negative.current = 0;
    shaft.speed - speed = 0;
    electromagnetic_torque - motor_constant * current = 0;
    shaft.torque + electromagnetic_torque = 0;
  }
}

public component InertialLoad(
  parameter inertia: kg * m ^ 2,
  parameter damping: kg * m ^ 2 / s,
  port shaft: RotationalFlange
) {
  state speed: 1 / s;
  variable reaction_torque: kg * m ^ 2 / s ^ 2;

  initial {
    speed = 0;
  }

  relation dynamics {
    shaft.speed - speed = 0;
    reaction_torque - inertia * derivative(speed) - damping * speed = 0;
    shaft.torque - reaction_torque = 0;
  }
}

public component SpeedSensor(
  port shaft: RotationalFlange,
  output speed: 1 / s
) {
  relation measurement {
    shaft.torque = 0;
    speed - shaft.speed = 0;
  }
}
