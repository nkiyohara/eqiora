"""Typed boundary for the private authoring adapter."""

from . import Module, ModuleRef, PropertyContract, PropertyRelease
from ._import_references import DeclarationRef

class ImportedPropertyContract(PropertyContract):
    def __init__(self, ref: DeclarationRef) -> None: ...

class ImportedPropertyRelease(PropertyRelease):
    def __init__(self, ref: DeclarationRef, required_contract: PropertyContract) -> None: ...

def contract(imported: ModuleRef, name: str, *, internal: bool = False) -> ImportedPropertyContract: ...
def release(imported: ModuleRef, name: str) -> ImportedPropertyRelease: ...
def same_contract(left: object, right: object) -> bool: ...
def admitted_contract(module: Module, value: object) -> bool: ...
