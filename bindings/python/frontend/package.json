{
  "name": "@eqiora/python-mesh-presentation",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "build": "vite build --configLoader runner",
    "format": "biome format --write src tests playwright.config.ts vite.config.ts",
    "lint": "biome lint src tests playwright.config.ts vite.config.ts",
    "test": "vitest run src",
    "test:hosts": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anywidget/types": "0.4.0",
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
