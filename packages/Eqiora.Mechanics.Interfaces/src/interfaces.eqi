public connector VelocityTractionBoundary = field_physical(
  trace = velocity: m / s,
  flux = traction: kg / (m * s ^ 2),
  shape = spatial_vector,
  frame = spatial,
  pairing = euclidean_boundary_duality
);

public component ZeroVelocity2d {
  public support body: volume(ambient_dimension = 2);
  public support face: boundary(parent = body);
  public port mechanical:
    conserving VelocityTractionBoundary over face;

  relation prescribed_velocity continuous on face {
    trace(mechanical) = 0;
  }
}

public component ZeroTraction2d {
  public support body: volume(ambient_dimension = 2);
  public support face: boundary(parent = body);
  public port mechanical:
    conserving VelocityTractionBoundary over face;

  relation prescribed_traction continuous on face {
    flux(mechanical) = 0;
  }
}

public component ZeroVelocity3d {
  public support body: volume(ambient_dimension = 3);
  public support face: boundary(parent = body);
  public port mechanical:
    conserving VelocityTractionBoundary over face;

  relation prescribed_velocity continuous on face {
    trace(mechanical) = 0;
  }
}

public component ZeroTraction3d {
  public support body: volume(ambient_dimension = 3);
  public support face: boundary(parent = body);
  public port mechanical:
    conserving VelocityTractionBoundary over face;

  relation prescribed_traction continuous on face {
    flux(mechanical) = 0;
  }
}
