public connector VelocityTractionBoundary = field_physical(
  trace = velocity: m / s,
  flux = traction: kg / (m * s ^ 2),
  shape = spatial_vector,
  frame = spatial,
  pairing = euclidean_boundary_duality
);

public component ZeroVelocity2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: conserving VelocityTractionBoundary over face
) {
  relation prescribed_velocity on face {
    trace(mechanical) = 0;
  }
}

public component ZeroTraction2d(
  support body: volume(ambient_dimension = 2),
  support face: boundary(parent = body),
  port mechanical: conserving VelocityTractionBoundary over face
) {
  relation prescribed_traction on face {
    flux(mechanical) = 0;
  }
}

public component ZeroVelocity3d(
  support body: volume(ambient_dimension = 3),
  support face: boundary(parent = body),
  port mechanical: conserving VelocityTractionBoundary over face
) {
  relation prescribed_velocity on face {
    trace(mechanical) = 0;
  }
}

public component ZeroTraction3d(
  support body: volume(ambient_dimension = 3),
  support face: boundary(parent = body),
  port mechanical: conserving VelocityTractionBoundary over face
) {
  relation prescribed_traction on face {
    flux(mechanical) = 0;
  }
}
