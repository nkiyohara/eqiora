public component InertialStokesWithPotential2d(
  support body: volume(ambient_dimension = 2),
  state velocity: vector<m / s, 2> on body,
  variable pressure: kg / (m * s ^ 2) on body,
  variable force_potential: kg / (m * s ^ 2) on body,
) {
  public parameter density: kg / m ^ 3;
  public parameter dynamic_viscosity: kg / (m * s);

  relation momentum on body {
    density * derivative(velocity)
      - div(
        2 * dynamic_viscosity * symmetric_part(grad(velocity))
        - isotropic_lift(pressure)
      ) - grad(force_potential) = 0;
  }
  relation incompressibility on body {
    div(velocity) = 0;
  }
}
