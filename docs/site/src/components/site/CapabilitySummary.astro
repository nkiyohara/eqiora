---
import ExactSourceLink from './ExactSourceLink.astro';

interface Props {
  id: string;
  title: string;
  outcome: string;
  conditions?: string;
  routeHref?: string;
  routeLabel?: string;
  casePath?: string;
}

const {
  id, title, outcome, conditions, routeHref, routeLabel, casePath,
} = Astro.props;
---

<article class="eq-capability" id={id}>
  <header class="eq-capability__header">
    <h3>{title}</h3>
  </header>
  <p class="eq-capability__outcome">{outcome}</p>
  {conditions && <p>{conditions}</p>}
  {(routeHref || casePath) && (
    <p class="eq-capability__links">
      {routeHref && <a href={routeHref}>{routeLabel ?? 'Open the related guide'}</a>}
      {casePath && <ExactSourceLink path={casePath} kind="blob">Case details</ExactSourceLink>}
    </p>
  )}
</article>
