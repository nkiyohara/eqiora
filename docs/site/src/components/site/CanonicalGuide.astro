---
import { canonicalGuide } from '../../canonical-guides';
import ExactSourceLink from './ExactSourceLink.astro';

const { name } = Astro.props;
const guide = canonicalGuide(name);
if (!guide) throw new Error(`No maintained Python guide: ${name}`);
const { Content } = guide;
---

<p class="eq-guide-source">
  <strong>Current-source Python API.</strong>{' '}
  <a href="/get-started/">Install this source revision</a>, then <a href="/guides/run-and-inspect/">run and inspect</a>.{' '}
  <ExactSourceLink path={`docs/python/${name}.md`} kind="blob">Canonical guide source</ExactSourceLink>.
</p>
<Content />

<style is:global>
  .eq-guide-source { font-size: var(--eq-text-small); color: var(--eq-color-text-muted); }
</style>
