{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "eqiora",
  "scopeName": "source.eqiora",
  "fileTypes": ["eqi"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#shapes" },
    { "include": "#units" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.eqiora",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(module|import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.declaration.eqiora" },
            "2": { "name": "entity.name.namespace.eqiora" }
          }
        },
        {
          "match": "\\b(component|connector|model|operator)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.eqiora" },
            "2": { "name": "entity.name.type.eqiora" }
          }
        },
        {
          "match": "\\b(field|parameter|support|port|relation|representation|instance|domain|clock)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.eqiora" },
            "2": { "name": "variable.other.definition.eqiora" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.eqiora",
          "match": "\\b(?:public|component|connector|model|operator|field|parameter|support|port|relation|representation|instance|domain|clock|continuous|discrete|on|as|connect|conserving|over|parent|ambient_dimension|trace|flux|shape|frame|pairing)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.eqiora",
          "match": "\\b(?:derivative|grad|div|trace|normal|symmetric_part|isotropic_lift|coordinate|volume|boundary|field_physical)\\b(?=\\s*\\()"
        }
      ]
    },
    "shapes": {
      "patterns": [
        {
          "name": "constant.language.eqiora",
          "match": "\\b(?:continuum|spatial_vector|spatial_scalar|scalar|spatial|euclidean_boundary_duality)\\b"
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "support.type.unit.eqiora",
          "match": "\\b(?:kg|m|s|A|K|mol|cd)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.eqiora",
          "match": "(?<![A-Za-z0-9_])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.eqiora",
          "match": "->|[=+\\-*/^]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.eqiora",
          "match": "[{}()\\[\\]]"
        },
        {
          "name": "punctuation.separator.eqiora",
          "match": "[;,:.]"
        }
      ]
    }
  }
}
