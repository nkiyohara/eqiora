{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Eqiora",
  "scopeName": "source.eqiora",
  "fileTypes": ["eqi"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#units" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": { "patterns": [{ "name": "comment.line.double-slash.eqiora", "match": "//.*$" }] },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(?:(public|private)\\s+)?(module|import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": { "1": { "name": "keyword.declaration.eqiora" }, "2": { "name": "keyword.declaration.eqiora" }, "3": { "name": "entity.name.namespace.eqiora" } }
        },
        {
          "match": "\\b(?:(public|private)\\s+)?(?:(property)\\s+(contract|release)|(material)\\s+(composition)|(pure)\\s+(operator)|(component|connector|model|dimension))\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.eqiora" }, "2": { "name": "keyword.declaration.eqiora" },
            "3": { "name": "keyword.declaration.eqiora" }, "4": { "name": "keyword.declaration.eqiora" },
            "5": { "name": "keyword.declaration.eqiora" }, "6": { "name": "keyword.declaration.eqiora" },
            "7": { "name": "keyword.declaration.eqiora" }, "8": { "name": "keyword.declaration.eqiora" },
            "9": { "name": "entity.name.type.eqiora" }
          }
        },
        {
          "match": "\\b(field|parameter|support|port|relation|representation|instance|domain|clock|let|form)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.eqiora" }, "2": { "name": "variable.other.definition.eqiora" } }
        }
      ]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.eqiora",
        "match": "\\b(?:across|ambient_dimension|as|axis|boundaries|boundary|citation|clock|complete_exterior|component|composition|connect|connector|conserving|continuous|contract|delta|dimension|discrete|domain|field|for|form|implements|import|in|input|instance|license|let|lower|material|model|module|on|operator|output|over|parameter|parent|period|periodic|phase|port|primal|private|property|public|pure|rational|relation|release|representation|scalar|shape|side|signal|slot|source_unit|spatial|support|through|unconditional|upper|validity|value|volume)\\b"
      }]
    },
    "functions": {
      "patterns": [{
        "name": "support.function.eqiora",
        "match": "\\b(?:boundary|boundaries|box|component|coordinate|derivative|div|dot|field_physical|flux|grad|integral|isotropic_lift|normal|scalar_physical|symmetric_part|trace|volume)\\b(?=\\s*\\()"
      }]
    },
    "constants": {
      "patterns": [{
        "name": "constant.language.eqiora",
        "match": "\\b(?:continuum|euclidean_boundary_duality|invariant|spatial_scalar|spatial_vector)\\b"
      }]
    },
    "units": {
      "patterns": [{ "name": "support.type.unit.eqiora", "match": "\\b(?:kg|m|s|A|K|mol|cd|Hz|N|Pa|J|W)\\b" }]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.eqiora", "match": "(?<![A-Za-z0-9_])(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?" }]
    },
    "operators": { "patterns": [{ "name": "keyword.operator.eqiora", "match": "->|[=+\\-*/^]" }] },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.eqiora", "match": "[{}()\\[\\]]" },
        { "name": "punctuation.separator.eqiora", "match": "[;,:.]" }
      ]
    }
  }
}
